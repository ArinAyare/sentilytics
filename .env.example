# ---------- Backend ----------
PREDICTOR_MODE=auto            # azure | local | auto (azure, then local fallback)
LOCAL_MODEL_PATH=artifacts/baseline/model.joblib
ARTIFACTS_DIR=artifacts
MONGO_URI=                     # e.g. mongodb://localhost:27017 ; empty = in-memory store (demo only)
MONGO_DB=sentilytics
API_KEY=                       # optional; if set, clients must send X-API-Key
MAX_UPLOAD_MB=5
MAX_BATCH_ROWS=5000
CORS_ORIGINS=http://localhost:5173

# ---------- Azure ML endpoint (filled after deploy_endpoint.py) ----------
AZURE_ML_SCORING_URI=
AZURE_ML_ENDPOINT_KEY=

# ---------- Azure ML workspace (used by azure/ scripts) ----------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
